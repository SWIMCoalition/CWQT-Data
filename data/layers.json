        "field": "status",
        "not_equals": "Active"
      },
      "title": "name",
      "subtitle": "status",
      "contacts": "lab_contacts",
      "style": {
        "icon": "flask",
        "color": "#8a8f99",
        "size": 20
      },
      "on": false,
      "hover": true
    },
