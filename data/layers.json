        {
          "_note": "NJDEP combined sewer overflow outfalls. NJDEP's file has no county, so it is looked up from the municipality in the NJ Overburdened Communities file.",
          "files": [
            "NJ_CSO_Outfalls*.geojson"
          ],
          "map": {
            "unitid": [
              "OUTFALL_ALT",
              "CSO_ID"
            ],
            "outfall_ty": {
              "value": "CSO"
            },
            "cso_id": "CSO_ID",
            "municipality": "MUNICIPALITY",
            "county": {
              "lookup": {
                "file": "NJ_Overburdened_Communities*.geojson",
                "key": "NAME",
                "value": "COUNTY",
                "match": "MUNICIPALITY"
              }
            },
            "receiving_": "RECV_WATER",
            "solids": "SOLIDS_FLOATABLES",
            "status": "CSO_STAT"
          },
          "where": {
            "any": [
              {
                "field": "county",
                "in_list": "nj_counties"
              },
              {
                "all": [
                  {
                    "field": "county",
                    "equals": "Passaic"
                  },
                  {
                    "field": "municipality",
                    "in_list": "nj_passaic_municipalities"
                  }
                ]
              }
            ]
          },
          "format": {
            "county": "title",
            "solids": "yesno"
          }
        },
        {
          "_note": "NJDEP MS4 outfall inventory. Discharge code R12 (highway agencies) is drawn as Highway; the rest as separate storm sewer (MS4). Owner is the permit holder (FACILITY_NAME), or OWNERTYPE when that is blank. About 200 rows have no county (written as 0); their county comes from other rows with the same permit holder.",
          "files": [
            "NJ_MS4_Outfalls*.geojson"
          ],
          "map": {
            "unitid": "OUTFALL_ID",
            "outfall_ty": {
              "from": "DISCHARGECODE",
              "map": {
                "R12": "HIGHWAY"
              },
              "default": "MS4"
            },
            "location": "ROADNAME",
            "municipality": "MUNICIPALITY",
            "county": [
              "COUNTY",
              {
                "lookup": {
                  "file": "NJ_MS4_Outfalls*.geojson",
                  "key": "FACILITY_NAME",
                  "value": "COUNTY",
                  "match": "FACILITY_NAME",
                  "ignore": [
                    "0"
                  ]
                }
              }
            ],
            "ownership": [
              "FACILITY_NAME",
              "OWNERTYPE"
            ],
            "pipe_material": "PIPEMATERIAL",
            "pipe_height": "PIPEHEIGHT",
            "receiving_area": "TYPEAREARECEIVING"
          },
          "missing": {
            "location": [
              "TBD",
              "N/A",
              "NA",
              "Unknown",
              "None",
              "0",
              "?",
              "-"
            ],
            "ownership": [
              "Unknown",
              "Unsure",
              "None",
              "0"
            ],
            "pipe_material": [
              "Unknown",
              "Unk",
              "?",
              "Other",
              "Not Applicable",
              "N/A",
              "<Null>",
              "Unknown/Could *",
              "None",
              "0"
            ],
            "receiving_area": [
              "Unknown",
              "Other",
              "None",
              "N/A",
              "0",
              "?"
            ],
            "county": [
              "0"
            ]
          },
